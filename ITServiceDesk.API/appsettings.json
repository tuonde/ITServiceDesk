{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.AspNetCore.HttpsPolicy.HttpsRedirectionMiddleware": "Error",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=ITServiceDeskDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "[SECRET_KEY_PLACEHOLDER]",
    "Issuer": "ITServiceDeskAPI",
    "Audience": "ITServiceDeskUsers",
    "ExpiryMinutes": 60
  },
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "DemoData": {
    "Enabled": false
  }
}