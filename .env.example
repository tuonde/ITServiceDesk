# Gerekli Güvenlik Değişkenleri
SQL_SA_PASSWORD=<set-a-strong-password>
JWT_SECRET=<set-a-32+-byte-secret-key-here>

# Production İçin İlk Admin (Bootstrap) Yapılandırması
